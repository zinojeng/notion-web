{
  "manifest_version": 3,
  "name": "Notion Web · 清晰收藏",
  "version": "0.1.0",
  "description": "將 Safari 網頁與 Facebook 單篇貼文整理為清楚標題、摘要、原文與來源，收藏到你的 Notion。",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.notion.com/*", "https://api.anthropic.com/*"],
  "background": { "scripts": ["background.js"], "persistent": false },
  "action": { "default_popup": "popup.html", "default_title": "收藏到 Notion", "default_icon": {"48":"icons/icon-48.png","128":"icons/icon-128.png"} },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": {"48":"icons/icon-48.png","96":"icons/icon-96.png","128":"icons/icon-128.png","256":"icons/icon-256.png","512":"icons/icon-512.png"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'none'; connect-src https://api.notion.com https://api.anthropic.com; img-src 'self' https:; base-uri 'none'"}
}
